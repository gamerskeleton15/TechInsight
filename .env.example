# TechInsight environment configuration
# Copy this file to .env (and .env.local) and fill in real values.
# Secrets live ONLY in .env, which is git-ignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string. Without this the site runs in blog-only mode
# (articles render; auth, writing, contact, newsletter return friendly errors).
# Supabase pooler format: postgres://USER:PASS@HOST:PORT/DBNAME?pgbouncer=true
DATABASE_URL=YOUR_DATABASE_URL_HERE

# ---------------------------------------------------------------------------
# Auth (admin-only login)
# ---------------------------------------------------------------------------
# Comma-separated list of emails allowed to log in / auto-create an account.
# First login for an admin email auto-creates the user record. Non-admin emails
# can log in ONLY if they already exist in the users table (no open signup).
# Example: ADMIN_EMAILS=you@example.com,coeditor@example.com
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AdSense (optional)
# ---------------------------------------------------------------------------
# Google AdSense publisher ID. No ads load until this is set.
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=

# ---------------------------------------------------------------------------
# Google Analytics 4 (optional)
# ---------------------------------------------------------------------------
# GA4 measurement ID. No tracking happens until this is set, and never in dev.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google Tag Manager (optional)
# ---------------------------------------------------------------------------
# GTM container ID. No tags fire until this is set, and never in dev.
# Format: GTM-XXXXXXXX
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Production domain. Override per environment (local, staging, production).
NEXT_PUBLIC_SITE_URL=https://techinsight.site

# ---------------------------------------------------------------------------
# Resend (optional — transactional email for contact form + newsletter)
# ---------------------------------------------------------------------------
# Set these to enable real email delivery. Without them the contact form and
# newsletter still save to the database but no email is sent.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# ---------------------------------------------------------------------------
# Maintenance mode (optional)
# ---------------------------------------------------------------------------
# When set to "true", all writes are blocked with a maintenance notice.
# MAINTENANCE_MODE=